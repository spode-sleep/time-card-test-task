{
  "name": "@time-card/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import=tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:integration": "node --env-file-if-exists=../.env ../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@time-card/shared": "0.1.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "prisma": "7.10.1",
    "vitest": "5.1.1",
    "supertest": "7.3.2",
    "@types/supertest": "7.2.1"
  }
}
