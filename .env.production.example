NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# For Compose, generate a random hexadecimal password, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=replace_with_random_hexadecimal_password
# Native Node.js startup only. On alwaysdata use the values from its database panel.
DATABASE_URL=postgresql://time_card:replace_with_random_hexadecimal_password@127.0.0.1:5432/time_card
